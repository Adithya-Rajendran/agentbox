# Generated by scripts/setup.sh; edit as needed. All paths absolute.
AGENTBOX_UID=1000                 # identity agentbox runs as; owns AGENTBOX_DATA and your repos
AGENTBOX_GID=1000
DOCKER_GID=988                    # getent group docker
AGENTBOX_AGENT_UID=64000          # agents run as this uid/gid; it does not need to exist on the host
AGENTBOX_AGENT_GID=64000
AGENTBOX_DATA=/home/you/.local/share/agentbox   # worktrees, gateway sockets, shadow git dirs, logs
AGENTBOX_REPOS_ROOT=/home/you/Projects          # repos delegate_task may work on
AGENTBOX_VENVS=/home/you/.cache/local-agent-venvs   # prebuilt venvs (skills/.../make_venv.sh)
OLLAMA_MODELS_DIR=/home/you/.local/share/agentbox/ollama
AGENTBOX_MCP_TOKEN=change-me-to-a-long-random-string
AGENTBOX_BRIDGE_TOKEN=change-me-too   # agentbox -> llm-bridge auth (provider keys go in secrets.env, not here)
# AGENTBOX_AGENT_RUNTIME=runsc    # optional: gVisor for agent containers, if installed
# AGENTBOX_PORT=8765
